ENVIRONMENT=development
WHATSAPP_APP_SECRET=replace-with-local-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-local-verification-token
WHATSAPP_ACCESS_TOKEN=replace-with-local-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_WABA_ID=replace-with-business-account-id
# Only required when WHATSAPP_TRANSPORT=twilio.
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+61400000000
# Optional deterministic behaviour overrides; defaults are documented in src/config.ts.
DATE_LOCALE=en-AU
AMBIGUOUS_NUMERIC_DATE_POLICY=clarify
DETERMINISTIC_MIN_TOPIC_TERM_LENGTH=3
DETERMINISTIC_ENABLE_WAITING_FACTS=true
DETERMINISTIC_ENABLE_FACT_RESOLUTION=true
DETERMINISTIC_ENABLE_REMINDER_CREATION=false
DETERMINISTIC_POLITE_FILLERS=please,kindly
DETERMINISTIC_TOPIC_STOP_WORDS=a,an,are,at,for,in,is,my,on,the,to,was,were
# Optional confirmed aliases, formatted as alias=canonical pairs separated by commas.
# DETERMINISTIC_TOPIC_ALIASES=driving appointment=driving test
